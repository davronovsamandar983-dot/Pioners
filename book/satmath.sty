%  satmath.sty -- design system for SAT Math Mastery
%
%  Matched to the SAT DAVLAT house style: navy/gold palette, the branded
%  header bar, the circular emblem watermark, two-column problem pages with
%  square question markers, and Module 2 restarting its numbering at 1.
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{satmath}[2026/08/15 SAT Math Mastery design system]

