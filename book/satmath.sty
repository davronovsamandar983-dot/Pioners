% ------------------------------------------------------ module dividers ----
\newcommand{\satmodulehead}[3]{%
  % #1 module number, #2 label, #3 subtitle
  \renewcommand{\satmodule}{#1}%
  \needspace{7\baselineskip}%
  \par\vspace{16pt}%
  \begin{tcolorbox}[width=\textwidth,colback=satnavy,colframe=satnavy,
      boxrule=0pt,arc=3pt,left=12pt,right=12pt,top=9pt,bottom=9pt,
      before skip=0pt,after skip=0pt]
    {\bfseries\large\color{white}MODULE #1}\;\;
    {\color{satsky}\textbar}\;\;
    {\color{white}#2}\hfill
    {\footnotesize\color{satsky}#3}
  \end{tcolorbox}%
  \par\vspace{2pt}}

% ------------------------------------------------------------- problems ----
% \satq{difficulty}{type}  begins a numbered practice problem
% difficulty: E | M | H     type: MC | SPR
\newcommand{\satdiffchip}[1]{%
  \ifstrequal{#1}{E}{\tikz[baseline=-2pt]\node[fill=satmint,text=satteal,
      rounded corners=1.5pt,inner xsep=4pt,inner ysep=1.5pt,
      font=\bfseries\tiny\sffamily]{EASY};}{}%
  \ifstrequal{#1}{M}{\tikz[baseline=-2pt]\node[fill=satsand,text=satamber,
      rounded corners=1.5pt,inner xsep=4pt,inner ysep=1.5pt,
      font=\bfseries\tiny\sffamily]{MEDIUM};}{}%
  \ifstrequal{#1}{H}{\tikz[baseline=-2pt]\node[fill=satrose,text=satcrimson,
      rounded corners=1.5pt,inner xsep=4pt,inner ysep=1.5pt,
      font=\bfseries\tiny\sffamily]{HARD};}{}}

\newcommand{\sattypechip}[1]{%
  \ifstrequal{#1}{SPR}{\tikz[baseline=-2pt]\node[draw=satline,line width=0.5pt,
      text=satgrey,rounded corners=1.5pt,inner xsep=4pt,inner ysep=1.5pt,
      font=\bfseries\tiny\sffamily]{STUDENT-PRODUCED};}{}}

\newenvironment{satq}[2]{%
  \refstepcounter{satproblem}%
  \needspace{5\baselineskip}%
  \par\vspace{10pt}%
  \noindent
  \begin{minipage}[t]{\textwidth}
  \noindent
  {\bfseries\color{satnavy}\thesatproblem.}\hspace{6pt}%
  \satdiffchip{#1}\;\sattypechip{#2}\par
  \vspace{3pt}
  \noindent\ignorespaces
}{%
  \end{minipage}\par\vspace{2pt}%
}

% four MCQ choices, laid out in two columns
\newcommand{\satchoices}[4]{%
  \par\vspace{5pt}
  \setlength{\columnsep}{12pt}
  \begin{multicols}{2}
  \begin{list}{}{\setlength{\leftmargin}{18pt}\setlength{\itemsep}{3pt}
                 \setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}
    \item[\textbf{\color{satblue}A)}] #1
    \item[\textbf{\color{satblue}B)}] #2
    \item[\textbf{\color{satblue}C)}] #3
    \item[\textbf{\color{satblue}D)}] #4
  \end{list}
  \end{multicols}}

% wide variant when a choice is long
\newcommand{\satchoiceswide}[4]{%
  \par\vspace{5pt}
  \begin{list}{}{\setlength{\leftmargin}{18pt}\setlength{\itemsep}{3pt}
                 \setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}
    \item[\textbf{\color{satblue}A)}] #1
    \item[\textbf{\color{satblue}B)}] #2
    \item[\textbf{\color{satblue}C)}] #3
    \item[\textbf{\color{satblue}D)}] #4
  \end{list}}

% grid-in answer box hint
\newcommand{\satgridin}{%
  \par\vspace{4pt}\noindent
  {\footnotesize\color{satgrey}\itshape Enter your answer in the grid.}}

% ------------------------------------------------------------ solutions ----
\newcounter{satsol}
\newcommand{\satsolhead}[2]{%
  % #1 problem number, #2 answer
  \needspace{3\baselineskip}
  \par\vspace{9pt}\noindent
  {\bfseries\color{satnavy}#1.}\hspace{6pt}%
  \tikz[baseline=-2pt]\node[fill=satnavy,text=white,rounded corners=2pt,
     inner xsep=5pt,inner ysep=2pt,font=\bfseries\footnotesize]{Answer: #2};
  \par\vspace{3pt}\noindent\ignorespaces}

\newenvironment{satsteps}{%
  \begin{list}{\textbf{\color{satteal}\arabic{satstepc}.}}%
    {\usecounter{satstepc}\setlength{\leftmargin}{20pt}
     \setlength{\itemsep}{2pt}\setlength{\parsep}{2pt}\setlength{\topsep}{3pt}}
}{\end{list}}
\newcounter{satstepc}

% --------------------------------------------------------- answer key ------
\newcommand{\satkeytable}[1]{%
