% the emblem watermark, centred on every body page
\newcommand{\satwatermark}{%
  \AddToShipoutPictureBG{%
    \begin{tikzpicture}[remember picture,overlay]
      \node at (current page.center)
        {\includegraphics[width=0.56\paperwidth]{\satlogowm}};
    \end{tikzpicture}}}

% ---------------------------------------------------------- part pages -----
\newcommand{\satpart}[2]{%
  % #1 part number, #2 part title
  \clearpage
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture,overlay]
    \node at (current page.center)
      {\includegraphics[width=0.56\paperwidth]{\satlogowm}};
    \node[anchor=center] at ($(current page.center)+(0,99pt)$)
      {\fontsize{10}{12}\selectfont\color{black}PART #1};
    \node[anchor=center] at ($(current page.center)+(0,61pt)$)
      {\fontsize{19}{22}\selectfont\bfseries\color{black}#2};
    \draw[satblue,line width=1pt]
      ($(current page.center)+(-82pt,36pt)$) --
      ($(current page.center)+( 82pt,36pt)$);
  \end{tikzpicture}
  \addcontentsline{toc}{part}{Part #1: #2}%
  \clearpage}

% ------------------------------------------------------------ a lesson -----
% \sattopic{number}{title}{domain}
\newcommand{\sattopic}[3]{%
  \setcounter{sattopicno}{#1}%
  \renewcommand{\sattopictitle}{#2}%
  \renewcommand{\sattopicdomain}{#3}%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{section}{Lesson #1: #2}%
  \markboth{#2}{#2}%
  \begin{center}
    {\fontsize{16}{19}\selectfont\bfseries Lesson #1: #2}\\[3pt]
    \textcolor{satnavy}{\rule{0.30\textwidth}{0.7pt}}
  \end{center}
  \vspace{2pt}
  \setcounter{satproblem}{0}}

\newcommand{\satmodulehead}[3]{%
  % #1 module number, #2 label, #3 subtitle -- restarts the question numbers
  \setcounter{satproblem}{0}%
  % Module 2 opens a fresh page, the way the adaptive second module is
  % presented; Module 1 simply follows the lesson.
  \ifnum#1>1 \clearpage\fi
  \needspace{5\baselineskip}%
  \par\vspace{6pt}%
  {\fontsize{13}{15}\selectfont\bfseries Module #1}%
  \ifstrempty{#2}{}{\ \ {\footnotesize\color{satgrey}#2}}%
  \par\vspace{4pt}}

