% ------------------------------------------------------------- counters ----
\newcounter{satproblem}[chapter]
\newcounter{sattopicno}
\newcommand{\satmodule}{1}
\newcommand{\sattopictitle}{}
\newcommand{\sattopicdomain}{}

% ------------------------------------------------------- page furniture ----
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[LE]{\footnotesize\color{satgrey}\textsc{sat math mastery}}
\fancyhead[RO]{\footnotesize\color{satgrey}\textsc{\nouppercase{\leftmark}}}
\fancyfoot[C]{%
  \begin{tikzpicture}[baseline]
    \node[fill=satnavy,text=white,rounded corners=2pt,
          inner xsep=7pt,inner ysep=3pt,font=\footnotesize\bfseries]
         {\thepage};
  \end{tikzpicture}}
\fancypagestyle{plain}{\fancyhf{}%
  \fancyfoot[C]{\begin{tikzpicture}[baseline]
    \node[fill=satnavy,text=white,rounded corners=2pt,
          inner xsep=7pt,inner ysep=3pt,font=\footnotesize\bfseries]
         {\thepage};\end{tikzpicture}}}

% --------------------------------------------------------- chapter head ----
\titleformat{\chapter}[display]
  {\normalfont}
  {}
  {0pt}
  {\satchapterhead}
\titlespacing*{\chapter}{0pt}{-40pt}{24pt}

% starred chapters (front matter, solutions, answer key) get no TOPIC label
\titleformat{name=\chapter,numberless}[display]
  {\normalfont}{}{0pt}{\satplainchapterhead}
\titlespacing*{name=\chapter,numberless}{0pt}{-40pt}{24pt}

\newcommand{\satplainchapterhead}[1]{%
  \begin{tikzpicture}
    \node[anchor=north west,inner sep=0pt] (bar) at (0,0)
      {\color{satnavy}\rule{\textwidth}{3pt}};
    \node[anchor=north west,inner sep=0pt,yshift=-16pt,text width=\textwidth]
         at (bar.south west)
      {\fontsize{26}{30}\selectfont\bfseries\color{satnavy}#1};
  \end{tikzpicture}%
  \vspace{6pt}}

\newcommand{\satchapterhead}[1]{%
  \begin{tikzpicture}
    \node[anchor=north west,inner sep=0pt] (bar) at (0,0)
      {\color{satnavy}\rule{\textwidth}{3pt}};
    \node[anchor=north west,inner sep=0pt,yshift=-14pt] at (bar.south west)
      {\fontsize{11}{13}\selectfont\bfseries\color{satblue}%
       TOPIC \thesattopicno\ \ \textcolor{satline}{\textbar}\ \
       \color{satgrey}\mdseries\sattopicdomain};
    \node[anchor=north west,inner sep=0pt,yshift=-34pt,text width=\textwidth] at (bar.south west)
      {\fontsize{26}{30}\selectfont\bfseries\color{satnavy}#1};
  \end{tikzpicture}%
  \vspace{6pt}}

% Start a topic: \sattopic{number}{title}{domain}
\newcommand{\sattopic}[3]{%
  \setcounter{sattopicno}{#1}%
  \renewcommand{\sattopictitle}{#2}%
  \renewcommand{\sattopicdomain}{#3}%
  \chapter{#2}%
  \markboth{Topic #1 \textbullet\ #2}{Topic #1 \textbullet\ #2}%
  \setcounter{satproblem}{0}%
  \renewcommand{\satmodule}{1}}

% ------------------------------------------------------- section styles ----
\titleformat{\section}
  {\normalfont\large\bfseries\color{satnavy}}{}{0pt}
  {\satsectionrule}
\titlespacing*{\section}{0pt}{16pt}{8pt}
\newcommand{\satsectionrule}[1]{%
  \raisebox{1pt}{\color{satteal}\rule{3pt}{11pt}}\hspace{7pt}#1}

\titleformat{\subsection}
  {\normalfont\normalsize\bfseries\color{satblue}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

