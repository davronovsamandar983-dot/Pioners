% ------------------------------------------------------------- problems ----
% the square marker carrying the question number
\newcommand{\satmarker}[1]{%
  \tikz[baseline=(n.base)]{
    \node[fill=satblue,text=white,inner xsep=3pt,inner ysep=2pt,
          minimum width=11pt,align=center,
          font=\bfseries\fontsize{8}{9}\selectfont] (n) {#1};}}

% \begin{satq}{difficulty}{type} -- difficulty and type are accepted so that
% content written against the earlier layout still compiles; the reference
% edition prints neither.
% A question and its choices must never be split across a column break, so
% the whole item is set in a minipage -- \needspace has no effect inside
% multicols, and a stem stranded at the foot of a column with its choices at
% the head of the next one is unreadable.
\newenvironment{satq}[2]{%
  \par\vspace{7pt}%
  \refstepcounter{satproblem}%
  \noindent\begin{minipage}{\linewidth}%
  \noindent\satmarker{\thesatproblem}\par\nobreak\vspace{2pt}%
  \noindent\ignorespaces
}{%
  \par\end{minipage}\par\vspace{1pt}%
}

% choices: one per line, "A)  ..."
\newcommand{\satchoicelist}[4]{%
  \par\vspace{3pt}
  \begin{list}{}{%
    \setlength{\leftmargin}{22pt}\setlength{\labelwidth}{16pt}%
    \setlength{\labelsep}{5pt}\setlength{\itemindent}{0pt}%
    \setlength{\itemsep}{4pt}\setlength{\parsep}{0pt}\setlength{\topsep}{0pt}}
    \item[A)] #1
    \item[B)] #2
    \item[C)] #3
    \item[D)] #4
  \end{list}}
\newcommand{\satchoices}[4]{\satchoicelist{#1}{#2}{#3}{#4}}
\newcommand{\satchoiceswide}[4]{\satchoicelist{#1}{#2}{#3}{#4}}

\newcommand{\satgridin}{}

% a figure inside a narrow column must never overrun it
% A figure written for a full-width page has to survive a narrow column.
% varwidth lets the content keep its own lists and centring while still
% reporting a natural width, which adjustbox can then shrink to fit.
\newenvironment{satfigure}{%
  \par\vspace{2pt}\noindent
  \begin{adjustbox}{max width=\linewidth,center}%
  \begin{varwidth}{\textwidth}%
}{%
  \end{varwidth}%
  \end{adjustbox}%
  \par\vspace{2pt}}

% ------------------------------------------------------ the problem body ---
\newenvironment{satproblems}{%
  \setlength{\columnsep}{20pt}%
  \begin{multicols}{2}\raggedcolumns
}{%
  \end{multicols}}

% ------------------------------------------------------------ solutions ----
\newcommand{\satsolhead}[2]{%
  \needspace{3\baselineskip}
  \par\vspace{7pt}\noindent
  \satmarker{#1}\hspace{5pt}%
  {\bfseries\color{satnavy}Answer: #2}%
  \par\vspace{2pt}\noindent\ignorespaces}

\newcounter{satstepc}
\newenvironment{satsteps}{%
  \begin{list}{\textbf{\color{satblue}\arabic{satstepc}.}}%
    {\usecounter{satstepc}\setlength{\leftmargin}{18pt}
     \setlength{\itemsep}{1pt}\setlength{\parsep}{1pt}\setlength{\topsep}{2pt}}
}{\end{list}}

