% ------------------------------------------------------- the brand bar -----
% The small emblem inside the header box.
\newcommand{\satemblem}[1][9mm]{%
  \raisebox{-0.32\height}{\includegraphics[height=#1]{\satlogo}}}

\newcommand{\satbrandbar}{%
  \noindent
  \begin{tikzpicture}
    \node[draw=satnavy,line width=0.8pt,inner sep=0pt,
          minimum width=\textwidth,minimum height=24pt,anchor=north west]
         (box) at (0,0) {};
    % left: emblem-in-a-disc + wordmark
    \node[anchor=west,inner sep=0pt] (disc) at ($(box.west)+(7pt,0)$)
      {\tikz\node[circle,fill=satnavy,inner sep=0pt,minimum size=15pt]
        {\color{white}\fontsize{6.6}{7}\selectfont\bfseries SAT};};
    \node[anchor=west,inner sep=0pt] at ($(disc.east)+(6pt,0)$)
      {\fontsize{15}{17}\selectfont\bfseries\color{satblue}\satbrandword};
    % right: a ruled cell holding the emblem
    \draw[satnavy,line width=0.8pt]
      ($(box.north east)+(-26pt,0)$) -- ($(box.south east)+(-26pt,0)$);
    \node[anchor=east,inner sep=0pt] at ($(box.east)+(-6pt,0)$)
      {\includegraphics[height=15pt]{\satlogo}};
  \end{tikzpicture}\par}

