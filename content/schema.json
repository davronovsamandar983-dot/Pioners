{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAT Math Mastery -- topic problem bank",
  "type": "object",
  "required": ["topic", "number", "domain", "lesson", "problems"],
  "additionalProperties": false,
  "properties": {
    "number":  { "type": "integer", "minimum": 1, "maximum": 20 },
    "topic":   { "type": "string", "minLength": 3 },
    "domain":  {
      "type": "string",
      "enum": [
        "Algebra",
        "Advanced Math",
        "Problem-Solving and Data Analysis",
        "Geometry and Trigonometry"
      ]
    },
    "skills": { "type": "array", "items": { "type": "string" } },

    "lesson": {
      "type": "object",
      "required": ["intro", "blocks"],
      "additionalProperties": false,
      "properties": {
        "intro":  { "type": "string" },
        "blocks": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["kind", "title", "body"],
            "additionalProperties": false,
            "properties": {
              "kind":  {
                "type": "string",
                "enum": ["concept", "formula", "trap", "strategy", "worked", "section"]
              },
              "title": { "type": "string" },
              "body":  { "type": "string" }
            }
          }
        }
      }
    },

    "problems": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": { "$ref": "#/definitions/problem" }
    }
  },

  "definitions": {
    "problem": {
      "type": "object",
      "required": ["id", "module", "n", "difficulty", "type", "stem", "answer", "solution"],
      "additionalProperties": false,
      "properties": {
        "id":         { "type": "string", "pattern": "^T[0-9]{2}-M[12]-[0-9]{2}$" },
        "module":     { "type": "integer", "enum": [1, 2] },
        "n":          { "type": "integer", "minimum": 1, "maximum": 44 },
        "difficulty": { "type": "string", "enum": ["E", "M", "H"] },
        "type":       { "type": "string", "enum": ["MC", "SPR"] },
        "skill":      { "type": "string" },
        "stem":       { "type": "string", "minLength": 5 },
        "figure":     { "type": "string" },
        "wide":       { "type": "boolean" },
        "form": {
          "type": "boolean",
          "description": "True when the question asks about the FORM of an expression rather than its value -- 'factored completely', 'which form displays the vertex as a constant'. Such a question deliberately offers a distractor that is mathematically equal to the key but written in the wrong form, so the distractor-equals-key check is suppressed for it."
        },
        "choices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "answer":     { "type": "string", "minLength": 1 },
        "accepted":   { "type": "array", "items": { "type": "string" } },
        "solution":   { "type": "string", "minLength": 10 },
        "steps":      { "type": "array", "items": { "type": "string" } },
        "verify":     { "type": "string" }
      },
      "allOf": [
        {
          "if":   { "properties": { "type": { "const": "MC" } } },
          "then": {
            "required": ["choices"],
            "properties": { "answer": { "enum": ["A", "B", "C", "D"] } }
          }
        },
        {
          "if":   { "properties": { "type": { "const": "SPR" } } },
          "then": { "not": { "required": ["choices"] } }
        }
      ]
    }
  }
}
